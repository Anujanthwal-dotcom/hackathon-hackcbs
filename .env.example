# Cura Health environment configuration
# Copy to .env and edit as needed. The demo works without an OpenAI key.

# Optional LLM enrichment. Without a key the edge agent uses a deterministic
# clinically structured SBAR fallback so the demo remains fully offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8

# Service locations
CENTRAL_URL=http://localhost:8000
EDGE_URL=http://localhost:8001
GENERATOR_URL=http://localhost:8002

# Browser-facing URLs (also used by the Next.js apps through NEXT_PUBLIC_*)
NEXT_PUBLIC_CENTRAL_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Simulation
TELEMETRY_INTERVAL_SECONDS=1.5
ALERT_NEWS2_THRESHOLD=7
